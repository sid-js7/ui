spdarena.online {
    root * /srv
    encode zstd gzip
    file_server

    # Handle React Router / client-side navigation
    try_files {path} /index.html

    # Long-term caching for hashed JS/CSS/images
    @static {
        file
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Prevent caching index.html so updates appear immediately
    header /index.html Cache-Control "no-cache, no-store, must-revalidate"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

bot.spdarena.online {
    reverse_proxy tournament-bot:8000
}
